cabal-version:       2.4
name:                cutegit
version:             0.1.0.0
build-type:          Simple

executable cutegit
  main-is:             Main.hs
  hs-source-dirs:      app
  default-language:    Haskell2010
  ghc-options:         -Wall
  build-depends:
      base >=4.14 && <5
    , directory
    , filepath
    , process
